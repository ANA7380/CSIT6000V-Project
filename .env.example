# Example only: Python entrypoints do NOT automatically load this file.
# Export these variables in your shell, or use the --base-url argument.
# The new scripts/tacc.py co-located deployment sets 127.0.0.1:42865 automatically.
# QWEN_BASE_URL below is only an example for a separately reachable service.
QWEN_BASE_URL=http://ACTUAL_SERVICE_HOST:8000/v1
# Existing course client uses model qwen3.8-27b.
# DeepSeek is optional for local chat; required for the no-tool live baseline.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
